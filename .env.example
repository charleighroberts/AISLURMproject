# Copy to .env and adjust. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

POSTGRES_HOST=db
POSTGRES_DB=policylab
POSTGRES_USER=policylab
POSTGRES_PASSWORD=devpassword

# Local: Mailpit catches every email. On the VM: DSU's SMTP relay.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@dsu.edu

# These addresses become admins the first time they sign in.
ADMIN_EMAILS=jared.t.soundy@dsu.edu,jim.cahill@dsu.edu,eric.holm@dsu.edu

# mock = canned responses, no GPU needed.
LLM_BACKEND=mock
MOCK_DELAY_SECONDS=8
